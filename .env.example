# Copier ce fichier en .env (jamais commité) et compléter.

# Chemin du WordPress géré par ce package. Par défaut : ../app/public
# (le dépôt est cloné dans ~/Local Sites/wp-starter/starter/, à côté de app/).
# WP_PATH=../app/public

# Courriel du compte administrateur créé par install.sh / new-site.sh
ADMIN_EMAIL=admin@repotz.com

# Licences (optionnel — permettent l'activation en ligne de commande quand le
# fournisseur l'offre ; sinon activer dans wp-admin après l'installation).
ELEMENTOR_PRO_LICENSE=
NOVAMIRA_LICENSE=

# URL publique utilisée pour les vérifications HTTP (verify.sh).
# Par défaut : celle de `wp option get siteurl`.
# SITE_URL=http://wp-starter.local
